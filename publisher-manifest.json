:after{content:\"+\";font-size:20px;font-weight:400;color:var(--brown-soft);line-height:1;flex:none}\n  details[open] summary::after{content:\"−\";color:var(--brown)}\n  details p{font-size:14.5px;color:#4f3d30;border-top:1px solid var(--line);padding-top:14px}\n\n  /* ---------- 页脚 ---------- */\n  footer{background:var(--brown-deep);color:rgba(246,241,234,.76);padding:40px 0 46px;font-size:14px}\n  .foot-grid{display:flex;justify-content:space-between;gap:24px;flex-wrap:wrap;align-items:flex-start}\n  .foot-brand{font-size:18px;font-weight:700;letter-spacing:.22em;color:var(--mint)}\n  .foot-links{display:flex;gap:18px;flex-wrap:wrap}\n  .foot-links a{text-decoration:none;color:rgba(246,241,234,.8)}\n  .foot-links a:hover{color:var(--mint)}\n  .foot-note{margin-top:22px;font-size:13px;color:rgba(246,241,234,.55);max-width:44em}\n\n  /* ---------- 响应式 ---------- */\n  @media (max-width:860px){.hero-grid{grid-template-columns:1fr;gap:30px;}\n    .howto{grid-template-columns:1fr;}\n    .plan{grid-template-columns:1fr;gap:18px;}\n    .clients{grid-template-columns:1fr;}\n    .section{padding:48px 0;}}\n  @media (max-width:520px){\n    .wrap{padding:0 16px}\n    .hero{padding:26px 0 44px}\n    .brandline{padding-bottom:14px}\n    .price{font-size:28px}\n    details{padding:0 16px}\n    summary{font-size:15px}\n  }\n</style><main>\n\n  <section class=\"hero\" id=\"top\">\n    <div class=\"wrap\">\n      <div class=\"brandline\">\n        <div class=\"brandmark\">光猫<span>网络接入说明</span></div>\n        <nav class=\"navchips\" aria-label=\"页内导航\">\n          <a href=\"#howto\">怎么用</a>\n          <a href=\"#plans\">套餐</a>\n          <a href=\"#clients\">客户端</a>\n          <a href=\"#faq\">常见问题</a>\n        </nav>\n      </div>\n\n      <div class=\"hero-grid\">\n        <div>\n          <h1>光猫 · 先看条款，<br>再决定<em>用哪一档</em>。</h1>\n          <p class=\"lede\">光猫把流量额度、同时在线设备数、线路安排写在同一页上。没有隐藏阶梯，没有临时加价。你按自己的使用习惯，挑一档即可。</p>\n          <p class=\"quote\">“少一点形容词，多一点能对得上的数字。”</p>\n        </div>\n\n        <div class=\"hero-side\">\n          <div class=\"hero-cell\">\n            <b>三档可选</b>\n            <span>基础、旗舰、团队，按月或按年。</span>\n          </div>\n          <div class=\"hero-cell\">\n            <b>信息口径</b>\n            <span>套餐内容以页面所列条款为准。</span>\n          </div>\n          <div class=\"hero-cell\">\n            <b>先读 FAQ</b>\n            <span>计费、设备数、线路问题集中在下文。</span>\n          </div>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <section class=\"section\" id=\"howto\">\n    <div class=\"wrap\">\n      <p class=\"eyebrow\">使用说明</p>\n      <h2>三步走完，不做多余动作</h2>\n      <p class=\"section-intro\">流程保持简单：选档、核对条款、按指引完成配置。每一步都能在页面上找到对应说明。</p>\n\n      <div class=\"howto\">\n        <article class=\"card\">\n          <span class=\"step-no\">第一步</span>\n          <h3>对照用量选档</h3>\n          <p>先估算每月流量与同时在线设备数。基础版适合单人轻量使用，旗舰版覆盖多设备日常，团队版面向多人共享场景。</p>\n        </article>\n        <article class=\"card\">\n          <span class=\"step-no\">第二步</span>\n          <h3>确认计费方式</h3>\n          <p>月付按自然月计算，年付一次性结算。两种方式的额度与设备数一致，区别只在付款周期，请按现金流安排选择。</p>\n        </article>\n        <article class=\"card\">\n          <span class=\"step-no\">第三步</span>\n          <h3>按指引完成设置</h3>\n          <p>开通后按客户端说明完成配置。不同系统的入口位置不同，遇到不一致时，以当次页面给出的说明为准。</p>\n        </article>\n      </div>\n    </div>\n  </section>\n\n  <section class=\"section\" id=\"plans\">\n    <div class=\"wrap\">\n      <p class=\"eyebrow\">套餐</p>\n      <h2>三档并列，逐条写清</h2>\n      <p class=\"section-intro\">每档都标注流量、设备数与线路安排。年付价格只在付款周期上让步，权益不做删减。</p>\n\n      <div class=\"plan-stack\">\n\n        <article class=\"plan\">\n          <div>\n            <div class=\"plan-name\">\n              <h3>基础版</h3>\n            </div>\n            <div class=\"price\">¥15<small>/月</small></div>\n            <p class=\"annual\">按年付仅需 ¥150/年</p>\n          </div>\n          <ul class=\"feat\">\n            <li>每月 100GB 流量额度</li>\n            <li>支持 3 台设备同时在线</li>\n            <li>基础流媒体解锁范围</li>\n            <li>普通线路节点池</li>\n          </ul>\n        </article>\n\n        <article class=\"plan featured\">\n          <div>\n            <div class=\"plan-name\">\n              <h3>旗舰版</h3>\n              <span class=\"tag\">推荐</span>\n            </div>\n            <div class=\"price\">¥35<small>/月</small></div>\n            <p class=\"annual\">按年付仅需 ¥350/年</p>\n          </div>\n          <ul class=\"feat\">\n            <li>每月 300GB 流量额度</li>\n            <li>支持 5 台设备同时在线</li>\n            <li>全节点原生流媒体解锁</li>\n            <li>IPLC 专线游戏加速优化</li>\n            <li>7×24 优先工单支持</li>\n          </ul>\n        </article>\n\n        <article class=\"plan\">\n          <div>\n            <div class=\"plan-name\">\n              <h3>团队版</h3>\n            </div>\n            <div class=\"price\">¥85<small>/月</small></div>\n            <p class=\"annual\">按年付仅需 ¥850/年</p>\n          </div>\n          <ul class=\"feat\">\n            <li>每月 1000GB 流量额度</li>\n            <li>支持 20 台设备同时在线</li>\n            <li>VIP 专属高带宽节点</li>\n            <li>支持企业定制路由</li>\n            <li>专属客户经理服务</li>\n          </ul>\n        </article>\n\n      </div>\n\n      <p class=\"plan-note\">以上为页面所列条款。实际开通条件、可用线路与支持响应以当次开通页面显示为准。</p>\n    </div>\n  </section>\n\n  <section class=\"section\" id=\"clients\">\n    <div class=\"wrap\">\n      <p class=\"eyebrow\">客户端</p>\n      <h2>在你的设备上完成设置</h2>\n      <p class=\"section-intro\">不同系统的配置入口不一样。下面按系统列出大致位置，具体以当次安装页面说明为准。</p>\n\n      <div class=\"clients\">\n        <article class=\"client\">\n          <h3>桌面端 · 电脑</h3>\n          <p>安装后进入配置页填写账户信息，按提示选择线路。首次登录建议先做一次连通性检查。</p>\n          <span class=\"hint\">安装包以当次开通页面为准</span>\n        </article>\n        <article class=\"client\">\n          <h3>移动端 · 手机与平板</h3>\n          <p>在系统设置中确认网络权限后，于应用内完成登录与线路选择，切换设备时留意在线设备数上限。</p>\n          <span class=\"hint\">入口以当次开通页面为准</span>\n        </article>\n        <article class=\"client\">\n          <h3>路由与局域网</h3>\n          <p>团队版支持企业定制路由，多人共享场景建议先在局域网内统计设备数，再决定分配方式。</p>\n          <span class=\"hint\">配置细节以页面说明为准</span>\n        </article>\n        <article class=\"client\">\n          <h3>切换与排查</h3>\n          <p>若线路表现不稳定，先切换节点再检查本地网络。问题持续时，按套餐对应的支持渠道提交工单。</p>\n          <span class=\"hint\">支持渠道见开通页面</span>\n        </article>\n      </div>\n    </div>\n  </section>\n\n  <section class=\"section\" id=\"faq\">\n    <div class=\"wrap\">\n      <p class=\"eyebrow\">常见问题</p>\n      <h2>你可能先问的几件事</h2>\n      <p class=\"section-intro\">点击展开。答案按条款写，不铺陈。</p>\n\n      <div class=\"faq\">\n        <details>\n          <summary>月付和年付有什么差别？</summary>\n          <p>额度、设备数与线路安排一致，差别只在付款周期。年付一次性结算，页面标注的年付价格已折算为全年金额。</p>\n        </details>\n        <details>\n          <summary>同时在线设备数怎么算？</summary>\n          <p>按同一时间处于连接状态的设备数量计算。基础版 3 台、旗舰版 5 台、团队版 20 台。超出上限时，需要先断开其他设备再接入。</p>\n        </details>\n        <details>\n          <summary>流量额度用完了会怎样？</summary>\n          <p>套餐内流量按自然月或年付周期计算，用完后请按页面提示处理。页面未写明的内容不作承诺，建议开通前确认当前周期规则。</p>\n        </details>\n        <details>\n          <summary>线路差异体现在哪里？</summary>\n          <p>基础版使用普通线路节点池；旗舰版与团队版在节点范围与带宽安排上有所区分，旗舰版标注 IPLC 专线游戏加速优化，团队版提供 VIP 专属高带宽节点。</p>\n        </details>\n        <details>\n          <summary>支持哪些系统？从哪里获取安装文件？</summary>\n          <p>桌面端与移动端均在客户端区块说明配置入口。安装文件与下载地址以当次开通页面为准，本页不提供下载链接。</p>\n        </details>\n        <details>\n          <summary>遇到问题怎么联系？</summary>\n          <p>旗舰版提供 7×24 优先工单支持，团队版配有专属客户经理。基础版用户请按开通页面给出的支持渠道提交问题。</p>\n        </details>\n      </div>\n    </div>\n  </section>\n\n</main>\n\n<footer>\n  <div class=\"wrap\">\n    <div class=\"foot-grid\">\n      <div>\n        <div class=\"foot-brand\">光猫</div>\n        <p class=\"foot-note\">页面内容用于说明套餐条款与使用流程。开通条件、线路与服务细节以当次开通页面显示为准。</p>\n      </div>\n      <div class=\"foot-links\">\n        <a href=\"#howto\">使用说明</a>\n        <a href=\"#plans\">套餐</a>\n        <a href=\"#clients\">客户端</a>\n        <a href=\"#faq\">常见问题</a>\n        <a href=\"#top\">回到顶部</a>\n      </div>\n    </div>\n  </div>\n</footer>",
